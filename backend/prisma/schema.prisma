// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEAM_MEMBER
  MANAGER
  ADMIN
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  NEEDS_CORRECTION
  APPROVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TimeCategory {
  DEVELOPMENT
  TESTING
  MEETINGS
  DOCUMENTATION
  OTHER
}

enum ReviewAction {
  APPROVED
  CHANGES_REQUESTED
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(TEAM_MEMBER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reports      Report[]
  reviews      Review[]

  @@index([role])
  @@index([email])
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reports     Report[]

  @@index([isActive])
}

model Report {
  id                   Int           @id @default(autoincrement())
  userId               Int
  projectId            Int
  weekStart            DateTime
  weekEnd              DateTime
  status               ReportStatus  @default(DRAFT)
  notes                String?       @db.Text
  links                String?       @db.Text
  currentVersionNumber Int           @default(1)
  submittedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project              Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  
  versions             ReportVersion[]
  tasks                Task[]
  blockers             Blocker[]
  achievements         Achievement[]
  timeBreakdowns       TimeBreakdown[]
  reviews              Review[]

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([weekStart])
}

model ReportVersion {
  id                 Int           @id @default(autoincrement())
  reportId           Int
  versionNumber      Int
  statusAtSubmission ReportStatus
  notes              String?       @db.Text
  links              String?       @db.Text
  snapshotData       String        @db.LongText // JSON serialized snapshot of tasks, blockers, achievements, hours
  submittedAt        DateTime      @default(now())

  report             Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  tasks              Task[]
  blockers           Blocker[]
  achievements       Achievement[]
  timeBreakdowns     TimeBreakdown[]
  reviews            Review[]

  @@unique([reportId, versionNumber])
  @@index([reportId])
}

model Task {
  id                  Int            @id @default(autoincrement())
  reportId            Int
  reportVersionId     Int?
  name                String
  priority            Priority       @default(MEDIUM)
  plannedPercent      Int            @default(0)
  actualPercent       Int            @default(0)
  status              TaskStatus     @default(NOT_STARTED)
  plannedHours        Float          @default(0)
  actualHours         Float          @default(0)
  deliverable         String?        @db.Text
  isPlannedForNextWeek Boolean        @default(false)
  createdAt           DateTime       @default(now())

  report              Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportVersion       ReportVersion? @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([reportVersionId])
}

model Blocker {
  id              Int            @id @default(autoincrement())
  reportId        Int
  reportVersionId Int?
  description     String         @db.Text
  isKeyBlocker    Boolean        @default(false)
  createdAt       DateTime       @default(now())

  report          Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportVersion   ReportVersion? @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([reportVersionId])
}

model Achievement {
  id               Int            @id @default(autoincrement())
  reportId         Int
  reportVersionId  Int?
  description      String         @db.Text
  isKeyAchievement Boolean        @default(false)
  createdAt        DateTime       @default(now())

  report           Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportVersion    ReportVersion? @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([reportVersionId])
}

model TimeBreakdown {
  id              Int            @id @default(autoincrement())
  reportId        Int
  reportVersionId Int?
  category        TimeCategory   @default(DEVELOPMENT)
  hours           Float          @default(0)
  createdAt       DateTime       @default(now())

  report          Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportVersion   ReportVersion? @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([reportVersionId])
}

model Review {
  id              Int            @id @default(autoincrement())
  reportId        Int
  reportVersionId Int?
  reviewerId      Int
  action          ReviewAction
  comment         String         @db.Text
  createdAt       DateTime       @default(now())

  report          Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportVersion   ReportVersion? @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)
  reviewer        User           @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@index([reportVersionId])
  @@index([reviewerId])
}
